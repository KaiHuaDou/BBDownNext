<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <!-- 覆盖根配置的 Release DebugType=none：coverlet 靠 pdb 做行级插桩 -->
        <DebugType>portable</DebugType>
        <!-- CA1707: xUnit 的 Method_Scenario_Expected 命名约定要求下划线 -->
        <NoWarn>$(NoWarn);CA1707</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.runner.visualstudio">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="System.CommandLine" />
        <PackageReference Include="coverlet.collector">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\BBDown\BBDown.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Using Include="Xunit" />
        <!-- 被测类型散落在 BBDown 的各子命名空间，测试文件自身在 namespace BBDown.Tests 下无法靠父命名空间查找到它们 -->
        <Using Include="BBDown" />
        <Using Include="BBDown.Auth" />
        <Using Include="BBDown.Cli" />
        <Using Include="BBDown.Download" />
        <Using Include="BBDown.Media" />
        <Using Include="BBDown.Mux" />
        <Using Include="BBDown.Pipeline" />
        <Using Include="BBDown.Serve" />
        <Using Include="BBDown.Util" />
    </ItemGroup>
</Project>
