<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <!-- 直接走 Microsoft Testing Platform 原生运行器，不再经过 VSTest -->
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
        <!-- CA1707: xUnit 的 Method_Scenario_Expected 命名约定要求下划线 -->
        <NoWarn>$(NoWarn);CA1707</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
        <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\BBDown.Core\BBDown.Core.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Using Include="Xunit" />
        <Using Include="BBDown.Core" />
        <Using Include="BBDown.Core.Auth" />
        <Using Include="BBDown.Core.Download" />
        <Using Include="BBDown.Core.Live" />
        <Using Include="BBDown.Core.Media" />
        <Using Include="BBDown.Core.Mux" />
        <Using Include="BBDown.Core.Pipeline" />
        <Using Include="BBDown.Core.Util" />
    </ItemGroup>
</Project>
