<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <StartupObject></StartupObject>
    </PropertyGroup>
    <!-- Win7 兼容构建：dotnet publish -r win-x64 -p:WindowsWin7Compat=true。
         net9.0-windows 是 YY-Thunks/VC-LTL 资产的前置 TFM，常规构建不受影响 -->
    <PropertyGroup Condition="'$(WindowsWin7Compat)' == 'true'">
        <TargetFramework>net9.0-windows</TargetFramework>
        <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    </PropertyGroup>
    <PropertyGroup>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Description>BBDown 是一个免费且便捷高效的哔哩哔哩下载/解析软件</Description>
        <PackageProjectUrl>https://github.com/KaiHuaDou/BBDownNext</PackageProjectUrl>
        <PackAsTool>true</PackAsTool>
        <IsPackable>true</IsPackable>
        <ToolCommandName>BBDown</ToolCommandName>
        <PackageOutputPath>./nupkg</PackageOutputPath>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="QRCoder" />
        <!-- Win7 兼容构建专用：YY-Thunks 链接期补旧系统缺失 API；VC-LTL 静态消除 api-ms-win-crt（仅 win-x64/x86 支持） -->
        <PackageReference Include="YY-Thunks" Condition="'$(WindowsWin7Compat)' == 'true'" />
        <PackageReference Include="VC-LTL" Condition="'$(WindowsWin7Compat)' == 'true'" />
        <!-- 仅 Windows 宿主生效（targets 内有 IsOSPlatform 判断，且垫片是 clang.cmd），需本机装 zig；
             用于本地交叉 publish Linux 目标，CI 的 musl 构建走 Alpine 容器不依赖它 -->
        <PackageReference Include="PublishAotCross" PrivateAssets="all" />
        <PackageReference Include="System.CommandLine" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\BBDown.Core\BBDown.Core.csproj" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="BBDown.Tests" />
    </ItemGroup>
</Project>
