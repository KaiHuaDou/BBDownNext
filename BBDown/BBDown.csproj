<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <StartupObject></StartupObject>
    </PropertyGroup>
    <PropertyGroup>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Description>BBDown是一个免费且便捷高效的哔哩哔哩下载/解析软件.</Description>
        <PackageProjectUrl>https://github.com/nilaoda/BBDown</PackageProjectUrl>
        <PackAsTool>true</PackAsTool>
        <IsPackable>true</IsPackable>
        <ToolCommandName>BBDown</ToolCommandName>
        <PackageOutputPath>./nupkg</PackageOutputPath>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="QRCoder" />
        <!-- 仅 Windows 宿主生效（targets 内有 IsOSPlatform 判断，且垫片是 clang.cmd），需本机装 zig；
             用于本地交叉 publish Linux 目标，CI 的 musl 构建走 Alpine 容器不依赖它 -->
        <PackageReference Include="PublishAotCross" PrivateAssets="all" />
        <PackageReference Include="System.CommandLine" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\BBDown.Core\BBDown.Core.csproj" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="BBDown.Tests" />
    </ItemGroup>
</Project>
