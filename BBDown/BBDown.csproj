<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <StartupObject></StartupObject>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>
    <PropertyGroup>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Version>2.0</Version>
        <Description>BBDown是一个免费且便捷高效的哔哩哔哩下载/解析软件.</Description>
        <PackageProjectUrl>https://github.com/nilaoda/BBDown</PackageProjectUrl>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>BBDown</ToolCommandName>
        <PackageOutputPath>./nupkg</PackageOutputPath>
    </PropertyGroup>
    <PropertyGroup>
        <AnalysisLevel>latest-all</AnalysisLevel>
        <WarningLevel>8</WarningLevel>
    </PropertyGroup>
    <PropertyGroup Condition="$(Configuration)==Debug">
        <DebugType>full</DebugType>
    </PropertyGroup>
    <PropertyGroup Condition="$(Configuration)==Release">
        <DebugType>none</DebugType>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="QRCoder" Version="1.8.0" />
        <PackageReference Include="System.CommandLine" Version="2.0.10" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\BBDown.Core\BBDown.Core.csproj" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="BBDown.Tests" />
    </ItemGroup>
</Project>
