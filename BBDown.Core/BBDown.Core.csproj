<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>library</OutputType>
        <!-- 主项目的 AOT 配置在 BBDown/Directory.Build.props 里，不覆盖 Core；单独开启才能在编译 Core 时就跑 AOT/Trim 分析器 -->
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Google.Protobuf" />
        <PackageReference Include="Grpc.Tools">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup>
        <!-- 这些 proto 只有 message 没有 service，生成 gRPC 客户端桩会产出一批 0 字节文件 -->
        <Protobuf Include="APP\**\*.proto" GrpcServices="None" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="BBDown.Core.Tests" />
    </ItemGroup>
</Project>
