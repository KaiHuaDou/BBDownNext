<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <RootNamespace>BBDown.DRM</RootNamespace>
        <AssemblyName>BBDown.DRM</AssemblyName>
        <!-- 与主程序同款源码规范：CA 全开、警告即错误 -->
        <AnalysisLevel>latest-all</AnalysisLevel>
        <WarningLevel>8</WarningLevel>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- 单文件自包含发布（非 AOT：自抓取用运行时反射序列化即可） -->
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <PublishTrimmed>false</PublishTrimmed>
    </PropertyGroup>

    <ItemGroup>
        <!-- 引用主仓库 Core：复用 HTTPUtil / CredentialStore / Utils 等 public API -->
        <ProjectReference Include="..\..\BBDown\BBDown.Core\BBDown.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="BBDown.DRM.Tests" />
    </ItemGroup>

</Project>
