<Window x:Class="BBDown.GUI.LoginWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="320"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock x:Name="ChannelText"
                   Margin="0,0,0,10" HorizontalAlignment="Center"
                   FontSize="16" FontWeight="Bold" />
        <Image x:Name="QrImage"
               Width="240" Height="240"
               HorizontalAlignment="Center"
               RenderOptions.BitmapInterpolationMode="None" />
        <TextBlock x:Name="StatusText"
                   Margin="0,15,0,0" HorizontalAlignment="Center"
                   FontSize="14"
                   Text="正在生成二维码..." />
        <Button x:Name="RetryButton"
                Margin="0,20,0,0" Padding="30,5" HorizontalAlignment="Center"
                Click="RetryButtonClicked" Content="重新生成二维码"
                IsVisible="False" />
        <Button x:Name="CancelButton"
                Margin="0,20,0,0" Padding="30,5" HorizontalAlignment="Center"
                Click="CancelButtonClicked" Content="取消" />
    </StackPanel>
</Window>
