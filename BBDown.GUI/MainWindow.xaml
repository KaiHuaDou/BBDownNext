<Window x:Class="BBDown.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BBDown GUI"
        Width="1120"
        Height="820"
        MinWidth="1024"
        MinHeight="768"
        AllowDrop="True"
        DragOver="WindowDragOver"
        Drop="WindowDrop"
        Closed="WindowClosed">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--左侧主区-->
        <Grid Width="640" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--顶部：下载目标-->
            <StackPanel Grid.Row="0">
                <DockPanel>
                    <TextBlock Margin="0,0,5,0" VerticalAlignment="Center" Text="目标" />
                    <TextBox x:Name="TargetBox" TextChanged="TargetBoxTextChanged" />
                </DockPanel>
                <TextBlock x:Name="TargetHintText" Margin="0,8,0,0" FontSize="14" />
            </StackPanel>

            <Grid x:Name="ContentGrid" Grid.Row="1" Margin="5">
                <!--内容复选框由 BBDown.Core.ContentSelector.Order 生成（字符/名称单一来源）-->
                <ItemsControl x:Name="ContentItems" Margin="5">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Style="{StaticResource CheckBoxItem}"
                                      Content="{Binding Item2}"
                                      Tag="{Binding Item1}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <ScrollViewer Grid.Row="2" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!--中下：选项-->
                    <Expander Header="选项">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--非整行选项：占满 GroupBox 宽度-->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Style="{StaticResource FieldLabel}"
                                           Text="分 P 选择" />
                                <TextBox x:Name="PagesBox"
                                         Grid.Row="0" Grid.Column="1"
                                         Style="{StaticResource FieldInput}"
                                         ToolTip="all / 8 / 1,2,5 / 3-5 / 16- / -22 / latest / last" />
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Style="{StaticResource FieldLabel}"
                                           Text="分 P 间隔（秒）" />
                                <TextBox x:Name="DelayPerPageBox"
                                         Grid.Row="1" Grid.Column="1"
                                         Style="{StaticResource FieldInput}"
                                         LostKeyboardFocus="IntegerBoxLostKeyboardFocus"
                                         ToolTip="合集分 P 之间的下载间隔（单位：秒）" />
                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Style="{StaticResource FieldLabel}"
                                           Text="评论条数" />
                                <TextBox x:Name="CommentsCountBox"
                                         Grid.Row="2" Grid.Column="1"
                                         Style="{StaticResource FieldInput}"
                                         LostKeyboardFocus="IntegerBoxLostKeyboardFocus"
                                         ToolTip="下载评论区前 N 条评论，0 表示不下载" />
                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Style="{StaticResource FieldLabel}"
                                           Text="评论排序" />
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                    <RadioButton x:Name="SortHotRadioButton"
                                                 Margin="0,3,8,3" VerticalAlignment="Center"
                                                 Content="热度" GroupName="CommentSort" />
                                    <RadioButton x:Name="SortTimeRadioButton"
                                                 Margin="0,3,0,3" VerticalAlignment="Center"
                                                 Content="时间" GroupName="CommentSort" />
                                </StackPanel>
                                <TextBlock Grid.Row="4" Grid.Column="0"
                                           Style="{StaticResource FieldLabel}"
                                           Text="评论格式" />
                                <StackPanel x:Name="CommentFormatPanel"
                                            Grid.Row="4" Grid.Column="1"
                                            Margin="0,0,10,0"
                                            Orientation="Horizontal">
                                    <CheckBox x:Name="CommentJsonCheckBox"
                                              Margin="0,3,8,3" VerticalAlignment="Center"
                                              Content="JSON" />
                                    <CheckBox x:Name="CommentTxtCheckBox"
                                              Margin="0,3,0,3" VerticalAlignment="Center"
                                              Content="TXT" />
                                </StackPanel>
                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Style="{StaticResource FieldLabel}"
                                           Text="弹幕格式" />
                                <StackPanel x:Name="DanmakuFormatPanel"
                                            Grid.Row="0" Grid.Column="3" Orientation="Horizontal">
                                    <CheckBox x:Name="DanmakuXmlCheckBox"
                                              Margin="0,3,8,3" VerticalAlignment="Center"
                                              Content="XML" />
                                    <CheckBox x:Name="DanmakuAssCheckBox"
                                              Margin="0,3,0,3" VerticalAlignment="Center"
                                              Content="ASS" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.Column="2"
                                           Style="{StaticResource FieldLabel}"
                                           Text="API 通道" />
                                <ComboBox x:Name="ApiBox"
                                          Grid.Row="1" Grid.Column="3"
                                          Margin="0,3,5,3"
                                          ToolTip="web / tv / app / intl，默认 web" />
                                <TextBlock Grid.Row="2" Grid.Column="2"
                                           Style="{StaticResource FieldLabel}"
                                           Text="直播清晰度" />
                                <ComboBox x:Name="LiveQualityBox"
                                          Grid.Row="2" Grid.Column="3"
                                          Margin="0,3,5,3" />
                                <TextBlock Grid.Row="3" Grid.Column="2"
                                           Style="{StaticResource FieldLabel}"
                                           Text="混流音频语言" />
                                <TextBox x:Name="LangBox"
                                         Grid.Row="3" Grid.Column="3"
                                         Style="{StaticResource FieldInput}"
                                         ToolTip="混流的音频语言代码，如 chi、jpn" />
                                <TextBlock Grid.Row="4" Grid.Column="2"
                                           Style="{StaticResource FieldLabel}"
                                           Text="aria2c 附加参数" />
                                <TextBox x:Name="Aria2cArgsBox"
                                         Grid.Row="4" Grid.Column="3"
                                         Style="{StaticResource FieldInput}" />
                            </Grid>

                            <!--布尔选项与整行选项并列-->
                            <Grid Grid.Row="1" Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                    <TextBlock Text="混流方式" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="MuxBox" Margin="0,3" />
                                    <CheckBox x:Name="UseAria2cCheckBox" Style="{StaticResource CheckBoxItem}" Content="使用 aria2c" />
                                    <CheckBox x:Name="SingleThreadCheckBox" Style="{StaticResource CheckBoxItem}" Content="单线程下载" />
                                    <CheckBox x:Name="InfoOnlyCheckBox"
                                              Style="{StaticResource CheckBoxItem}"
                                              Checked="InfoOnlyCheckBoxChanged" Unchecked="InfoOnlyCheckBoxChanged"
                                              Content="仅解析不下载" />
                                    <CheckBox x:Name="ShowAllCheckBox" Style="{StaticResource CheckBoxItem}" Content="展示全部分 P 标题" />
                                    <CheckBox x:Name="AllowPreviewCheckBox" Style="{StaticResource CheckBoxItem}" Content="允许下载试看片段" />
                                    <CheckBox x:Name="SaveRecordsCheckBox" Style="{StaticResource CheckBoxItem}" Content="下载记录去重" />
                                    <CheckBox x:Name="StopOnErrorCheckBox" Style="{StaticResource CheckBoxItem}" Content="失败即停止" />
                                    <CheckBox x:Name="DebugCheckBox"
                                              Style="{StaticResource CheckBoxItem}"
                                              Checked="DebugCheckBoxChecked"
                                              Content="调试日志" />
                                    <CheckBox x:Name="VideoAscendingCheckBox" Style="{StaticResource CheckBoxItem}" Content="视频升序（体积小优先）" />
                                    <CheckBox x:Name="AudioAscendingCheckBox" Style="{StaticResource CheckBoxItem}" Content="音频升序（体积小优先）" />
                                </StackPanel>
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Style="{StaticResource FieldLabel}"
                                               Text="编码优先级" />
                                    <TextBox x:Name="EncodingPriorityBox"
                                             Grid.Row="0" Grid.Column="1"
                                             Style="{StaticResource FieldInput}"
                                             ToolTip="逗号分隔，如 hevc,av1,avc,flac,eac3,m4a" />
                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Style="{StaticResource FieldLabel}"
                                               Text="画质优先级" />
                                    <TextBox x:Name="DfnPriorityBox"
                                             Grid.Row="1" Grid.Column="1"
                                             Style="{StaticResource FieldInput}"
                                             ToolTip="逗号分隔，如 8K 超高清,1080P 高码率,HDR 真彩,杜比视界" />
                                    <TextBlock Grid.Row="2" Grid.Column="0"
                                               Style="{StaticResource FieldLabel}"
                                               Text="Cookie" />
                                    <TextBox x:Name="CookieBox"
                                             Grid.Row="2" Grid.Column="1"
                                             Style="{StaticResource FieldInput}" />
                                    <TextBlock Grid.Row="3" Grid.Column="0"
                                               Style="{StaticResource FieldLabel}"
                                               Text="access_token" />
                                    <TextBox x:Name="AccessTokenBox"
                                             Grid.Row="3" Grid.Column="1"
                                             Style="{StaticResource FieldInput}" />
                                    <TextBlock Grid.Row="4" Grid.Column="0"
                                               Style="{StaticResource FieldLabel}"
                                               Text="User-Agent" />
                                    <TextBox x:Name="UserAgentBox"
                                             Grid.Row="4" Grid.Column="1"
                                             Style="{StaticResource FieldInput}" />
                                    <TextBlock Grid.Row="5" Grid.Column="0"
                                               Style="{StaticResource FieldLabel}"
                                               Text="工作目录" />
                                    <DockPanel Grid.Row="5" Grid.Column="1" Margin="0,3,5,3">
                                        <Button x:Name="BrowseDirButton"
                                                DockPanel.Dock="Right"
                                                Margin="5,0,0,0" Padding="8,2"
                                                Click="BrowseDirButtonClicked" Content="..." />
                                        <TextBox x:Name="WorkDirBox"
                                                 ToolTip="程序的工作目录，也是下载输出位置" />
                                    </DockPanel>
                                    <TextBlock Grid.Row="6" Grid.Column="0"
                                               Style="{StaticResource FieldLabel}"
                                               Text="FFmpeg 路径" />
                                    <DockPanel Grid.Row="6" Grid.Column="1" Margin="0,3,5,3">
                                        <Button x:Name="BrowseFfmpegButton"
                                                DockPanel.Dock="Right"
                                                Margin="5,0,0,0" Padding="8,2"
                                                Tag="ffmpeg"
                                                Click="BrowseFileButtonClicked" Content="..." />
                                        <TextBox x:Name="FFmpegPathBox" />
                                    </DockPanel>
                                    <TextBlock Grid.Row="7" Grid.Column="0"
                                               Style="{StaticResource FieldLabel}"
                                               Text="MP4Box 路径" />
                                    <DockPanel Grid.Row="7" Grid.Column="1" Margin="0,3,5,3">
                                        <Button x:Name="BrowseMp4boxButton"
                                                DockPanel.Dock="Right"
                                                Margin="5,0,0,0" Padding="8,2"
                                                Tag="mp4box"
                                                Click="BrowseFileButtonClicked" Content="..." />
                                        <TextBox x:Name="Mp4boxPathBox" />
                                    </DockPanel>
                                    <TextBlock Grid.Row="8" Grid.Column="0"
                                               Style="{StaticResource FieldLabel}"
                                               Text="aria2c 路径" />
                                    <DockPanel Grid.Row="8" Grid.Column="1" Margin="0,3,5,3">
                                        <Button x:Name="BrowseAria2cButton"
                                                DockPanel.Dock="Right"
                                                Margin="5,0,0,0" Padding="8,2"
                                                Tag="aria2c"
                                                Click="BrowseFileButtonClicked" Content="..." />
                                        <TextBox x:Name="Aria2cPathBox" />
                                    </DockPanel>
                                    <TextBlock Grid.Row="9" Grid.Column="0"
                                               Style="{StaticResource FieldLabel}"
                                               Text="后处理程序" />
                                    <DockPanel Grid.Row="9" Grid.Column="1" Margin="0,3,5,3">
                                        <Button x:Name="BrowsePostProcessButton"
                                                DockPanel.Dock="Right"
                                                Margin="5,0,0,0" Padding="8,2"
                                                Tag="postprocess"
                                                Click="BrowseFileButtonClicked" Content="..." />
                                        <TextBox x:Name="PostProcessPathBox"
                                                 ToolTip="下载完成后由外部进程处理后缀为 .out 的轨道文件；留空则不启用" />
                                    </DockPanel>
                                    <TextBlock Grid.Row="10" Grid.Column="0"
                                               Style="{StaticResource FieldLabel}"
                                               Text="文件命名模式" />
                                    <TextBox x:Name="FilePatternBox"
                                             Grid.Row="10" Grid.Column="1"
                                             Style="{StaticResource FieldInput}"
                                             ToolTip="单 P 文件名模板，内置变量见 BBDown --help" />
                                    <TextBlock Grid.Row="11" Grid.Column="0"
                                               Style="{StaticResource FieldLabel}"
                                               Text="多 P 文件命名" />
                                    <TextBox x:Name="MultiFilePatternBox"
                                             Grid.Row="11" Grid.Column="1"
                                             Style="{StaticResource FieldInput}"
                                             ToolTip="多 P 文件名模板，内置变量见 BBDown --help" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Expander>

                    <!--高级选项-->
                    <Expander Header="高级选项" Margin="0,5,0,0">
                        <Grid Margin="3,10,3,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                <CheckBox x:Name="AllowPcdnCheckBox" Style="{StaticResource CheckBoxItem}" Content="允许 PCDN" />
                                <CheckBox x:Name="NoForceHostCheckBox" Style="{StaticResource CheckBoxItem}" Content="不强制替换 host" />
                                <CheckBox x:Name="NoForceHttpCheckBox" Style="{StaticResource CheckBoxItem}" Content="避免降级 HTTP" />
                            </StackPanel>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Style="{StaticResource FieldLabel}"
                                           Text="Host" />
                                <TextBox x:Name="HostBox"
                                         Grid.Row="0" Grid.Column="1"
                                         Margin="0,3,10,3"
                                         ToolTip="BiliPlus host，需 access_token，谨慎使用" />
                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Style="{StaticResource FieldLabel}"
                                           Text="EP Host" />
                                <TextBox x:Name="EpHostBox"
                                         Grid.Row="0" Grid.Column="3"
                                         Style="{StaticResource FieldInput}"
                                         ToolTip="BiliPlus EP host，代理 pgc season 接口" />
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Style="{StaticResource FieldLabel}"
                                           Text="TV Host" />
                                <TextBox x:Name="TvHostBox"
                                         Grid.Row="1" Grid.Column="1"
                                         Margin="0,3,10,3"
                                         ToolTip="自定义 TV 端接口请求 Host" />
                                <TextBlock Grid.Row="1" Grid.Column="2"
                                           Style="{StaticResource FieldLabel}"
                                           Text="Area" />
                                <TextBox x:Name="AreaBox"
                                         Grid.Row="1" Grid.Column="3"
                                         Style="{StaticResource FieldInput}"
                                         ToolTip="BiliPlus 区域：hk / tw / th" />
                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Style="{StaticResource FieldLabel}"
                                           Text="Upos Host" />
                                <TextBox x:Name="UposHostBox"
                                         Grid.Row="2" Grid.Column="1"
                                         Margin="0,3,0,3"
                                         ToolTip="自定义 upos 服务器" />
                            </Grid>
                        </Grid>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <!--底部：操作按钮-->
            <StackPanel Grid.Row="3" Margin="0,10,0,0" Orientation="Horizontal">
                <Button x:Name="RunButton"
                        Style="{StaticResource ButtonAction}"
                        Click="RunButtonClicked" Content="执行" />
                <Button x:Name="EnqueueButton"
                        Margin="10,0,0,0" Style="{StaticResource ButtonAction}"
                        Click="EnqueueButtonClicked" Content="加入任务队列" />
                <Button x:Name="ResetButton"
                        Margin="10,0,0,0" Style="{StaticResource ButtonAction}"
                        Click="ResetButtonClicked" Content="重置选项" />
                <Button x:Name="OpenDirButton"
                        Margin="10,0,0,0" Style="{StaticResource ButtonAction}"
                        Click="OpenDirButtonClicked" Content="打开输出目录" />
            </StackPanel>

        </Grid>

        <!--右侧边栏：任务队列-->
        <Grid Grid.Column="1"
              MinWidth="256" MaxWidth="512"
              Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0">
                <TextBlock x:Name="QueueStatusText"
                           DockPanel.Dock="Top"
                           Margin="0,0,0,5" FontSize="12" />
                <ListBox x:Name="TaskList"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         SelectionChanged="TaskListSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <Button x:Name="CancelButton"
                                        DockPanel.Dock="Right"
                                        Margin="6,0,0,0" Padding="8,1"
                                        Content="取消"
                                        Visibility="Collapsed"
                                        Click="CancelTaskButtonClicked"
                                        Tag="{Binding}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="StatusText" Text="{Binding StatusText}" FontWeight="Bold" />
                                    <TextBlock Text=" | " />
                                    <TextBlock Text="{Binding Url}" TextWrapping="WrapWithOverflow" />
                                </StackPanel>
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Running">
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#2F6FEB" />
                                    <Setter TargetName="CancelButton" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Success">
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#4CAF50" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#E53935" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#9E9E9E" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <StackPanel Grid.Row="1"
                        Margin="0,10,0,0" HorizontalAlignment="Left"
                        Orientation="Horizontal">
                <TextBlock Margin="0,0,5,0" VerticalAlignment="Center" Text="并发数" />
                <TextBox x:Name="ConcurrencyBox"
                         LostKeyboardFocus="ConcurrencyBoxLostKeyboardFocus" Text="3"
                         TextAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0,10,0,0" Orientation="Horizontal">
                <Button x:Name="StartQueueButton"
                        Style="{StaticResource ButtonAction}"
                        Click="StartQueueButtonClicked" Content="开始队列" />
                <Button x:Name="RemoveButton"
                        Margin="10,0,0,0" Style="{StaticResource ButtonAction}"
                        IsEnabled="False"
                        Click="RemoveButtonClicked" Content="移除" />
                <Button x:Name="ClearButton"
                        Margin="10,0,0,0" Style="{StaticResource ButtonAction}"
                        Click="ClearButtonClicked" Content="清空已完成" />
            </StackPanel>

            <!--底部：日志区-->
            <Expander x:Name="LogExpander" Header="日志" Grid.Row="4" Margin="0,5,0,0" IsExpanded="True">
                <RichTextBox x:Name="LogBox"
                             MaxHeight="256"
                             FontFamily="Consolas"
                             Background="{x:Static SystemColors.WindowBrush}"
                             Foreground="{x:Static SystemColors.WindowTextBrush}"
                             IsReadOnly="True"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto" />
            </Expander>
        </Grid>
    </Grid>
</Window>
