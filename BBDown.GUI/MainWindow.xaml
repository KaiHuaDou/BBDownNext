<Window x:Class="BBDown.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BBDown GUI"
        MinWidth="1024"
        MinHeight="768"
        Closed="WindowClosed"
        SizeToContent="WidthAndHeight">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--左侧主区-->
        <Grid Width="640" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--顶部：可执行文件与下载目标-->
            <StackPanel Grid.Row="0">
                <DockPanel>
                    <Button x:Name="ExeDetectButton"
                            DockPanel.Dock="Right"
                            Margin="5,0,0,0" Padding="15,3"
                            Click="ExeDetectButtonClicked" Content="自动检测" />
                    <Button x:Name="ExeSelectButton"
                            DockPanel.Dock="Right"
                            Margin="5,0,0,0" Padding="15,3"
                            Click="ExeSelectButtonClicked" Content="..." />
                    <TextBox x:Name="ExePathBox" LostKeyboardFocus="ExePathBoxLostKeyboardFocus" />
                </DockPanel>
                <TextBlock x:Name="ExeHintText" Margin="0,2,0,0" FontSize="11" />
                <DockPanel Margin="0,10,0,0">
                    <TextBlock Margin="0,0,5,0" VerticalAlignment="Center" Text="下载目标" />
                    <TextBox x:Name="TargetBox" TextChanged="TargetBoxTextChanged" />
                </DockPanel>
                <TextBlock x:Name="TargetHintText" Margin="0,8,0,0" FontSize="14" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <CheckBox x:Name="AudioCheckBox"
                          Grid.Row="0" Grid.Column="0"
                          Margin="0,3"
                          Content="音频 (_a)" />
                <CheckBox x:Name="VideoCheckBox"
                          Grid.Row="0" Grid.Column="1"
                          Margin="0,3"
                          Content="视频 (_v)" />
                <CheckBox x:Name="CoverFileCheckBox"
                          Grid.Row="0" Grid.Column="2"
                          Margin="0,3"
                          Content="封面文件 (_c)" />
                <CheckBox x:Name="CoverMuxCheckBox"
                          Grid.Row="1" Grid.Column="0"
                          Margin="0,3"
                          Content="封面混流 (_C)" />
                <CheckBox x:Name="DanmakuCheckBox"
                          Grid.Row="1" Grid.Column="1"
                          Margin="0,3"
                          Content="弹幕 (_d)" />
                <CheckBox x:Name="ArticleImageCheckBox"
                          Grid.Row="1" Grid.Column="2"
                          Margin="0,3"
                          Content="专栏图片 (_i)" />
                <CheckBox x:Name="MetadataCheckBox"
                          Grid.Row="2" Grid.Column="0"
                          Margin="0,3"
                          Content="混流元数据 (_m)" />
                <CheckBox x:Name="YamlCheckBox"
                          Grid.Row="2" Grid.Column="1"
                          Margin="0,3"
                          Content="front-matter (_M)" />
                <CheckBox x:Name="CommentCheckBox"
                          Grid.Row="2" Grid.Column="2"
                          Margin="0,3"
                          Content="评论 (_o)" />
                <CheckBox x:Name="AllCommentCheckBox"
                          Grid.Row="3" Grid.Column="0"
                          Margin="0,3"
                          Content="全部评论 (_O)" />
                <CheckBox x:Name="AiSubtitleCheckBox"
                          Grid.Row="3" Grid.Column="1"
                          Margin="0,3"
                          Content="AI 字幕 (_S)" />
                <CheckBox x:Name="SubtitleCheckBox"
                          Grid.Row="3" Grid.Column="2"
                          Margin="0,3"
                          Content="字幕 (_s)" />
            </Grid>

            <ScrollViewer Grid.Row="2" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!--中下：选项-->
                    <Expander Header="选项">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--非整行选项：占满 GroupBox 宽度-->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Margin="0,3,5,3" VerticalAlignment="Center"
                                           Text="分 P 选择" />
                                <TextBox x:Name="PagesBox"
                                         Grid.Row="0" Grid.Column="1"
                                         Margin="0,3,10,3" />
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Margin="0,3,5,3" VerticalAlignment="Center"
                                           Text="分 P 间隔（秒）" />
                                <TextBox x:Name="DelayPerPageBox"
                                         Grid.Row="1" Grid.Column="1"
                                         Margin="0,3,10,3" />
                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Margin="0,3,5,3" VerticalAlignment="Center"
                                           Text="评论条数" />
                                <TextBox x:Name="CommentsCountBox"
                                         Grid.Row="2" Grid.Column="1"
                                         Margin="0,3,10,3" />
                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Margin="0,3,5,3" VerticalAlignment="Center"
                                           Text="评论排序" />
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                    <RadioButton x:Name="SortHotRadioButton"
                                                 Margin="0,3,8,3" VerticalAlignment="Center"
                                                 Content="热度" GroupName="CommentSort" />
                                    <RadioButton x:Name="SortTimeRadioButton"
                                                 Margin="0,3,0,3" VerticalAlignment="Center"
                                                 Content="时间" GroupName="CommentSort" />
                                </StackPanel>
                                <TextBlock Grid.Row="4" Grid.Column="0"
                                           Margin="0,3,5,3" VerticalAlignment="Center"
                                           Text="评论格式" />
                                <StackPanel Grid.Row="4" Grid.Column="1"
                                            Margin="0,0,10,0"
                                            Orientation="Horizontal">
                                    <CheckBox x:Name="CommentJsonCheckBox"
                                              Margin="0,3,8,3" VerticalAlignment="Center"
                                              Content="JSON" />
                                    <CheckBox x:Name="CommentTxtCheckBox"
                                              Margin="0,3,0,3" VerticalAlignment="Center"
                                              Content="TXT" />
                                </StackPanel>
                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Margin="0,3,5,3" VerticalAlignment="Center"
                                           Text="弹幕格式" />
                                <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal">
                                    <CheckBox x:Name="DanmakuXmlCheckBox"
                                              Margin="0,3,8,3" VerticalAlignment="Center"
                                              Content="XML" />
                                    <CheckBox x:Name="DanmakuAssCheckBox"
                                              Margin="0,3,0,3" VerticalAlignment="Center"
                                              Content="ASS" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.Column="2"
                                           Margin="0,3,5,3" VerticalAlignment="Center"
                                           Text="API 通道" />
                                <ComboBox x:Name="ApiBox"
                                          Grid.Row="1" Grid.Column="3"
                                          Margin="0,3,5,3" />
                                <TextBlock Grid.Row="2" Grid.Column="2"
                                           Margin="0,3,5,3" VerticalAlignment="Center"
                                           Text="直播清晰度" />
                                <ComboBox x:Name="LiveQualityBox"
                                          Grid.Row="2" Grid.Column="3"
                                          Margin="0,3,5,3" />
                                <TextBlock Grid.Row="3" Grid.Column="2"
                                           Margin="0,3,5,3" VerticalAlignment="Center"
                                           Text="混流音频语言" />
                                <TextBox x:Name="LangBox"
                                         Grid.Row="3" Grid.Column="3"
                                         Margin="0,3,5,3" />
                                <TextBlock Grid.Row="4" Grid.Column="2"
                                           Margin="0,3,5,3" VerticalAlignment="Center"
                                           Text="aria2c 附加参数" />
                                <TextBox x:Name="Aria2cArgsBox"
                                         Grid.Row="4" Grid.Column="3"
                                         Margin="0,3,5,3" />
                            </Grid>

                            <!--布尔选项与整行选项并列-->
                            <Grid Grid.Row="1" Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                    <TextBlock Text="混流方式" Margin="0,3" />
                                    <ComboBox x:Name="MuxBox" Margin="0,3" />
                                    <CheckBox x:Name="UseAria2cCheckBox" Margin="0,3" Content="使用 aria2c" />
                                    <CheckBox x:Name="SingleThreadCheckBox" Margin="0,3" Content="单线程下载" />
                                    <CheckBox x:Name="InfoOnlyCheckBox" Margin="0,3" Content="仅解析不下载" />
                                    <CheckBox x:Name="ShowAllCheckBox" Margin="0,3" Content="展示全部分 P 标题" />
                                    <CheckBox x:Name="AllowPreviewCheckBox" Margin="0,3" Content="允许下载试看片段" />
                                    <CheckBox x:Name="SaveRecordsCheckBox" Margin="0,3" Content="下载记录去重" />
                                    <CheckBox x:Name="StopOnErrorCheckBox" Margin="0,3" Content="失败即停止" />
                                    <CheckBox x:Name="DebugCheckBox" Margin="0,3" Content="调试日志" />
                                    <CheckBox x:Name="VideoAscendingCheckBox" Margin="0,3" Content="视频升序（体积小优先）" />
                                    <CheckBox x:Name="AudioAscendingCheckBox" Margin="0,3" Content="音频升序（体积小优先）" />
                                </StackPanel>
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Margin="0,3,5,3" VerticalAlignment="Center"
                                               Text="编码优先级" />
                                    <TextBox x:Name="EncodingPriorityBox"
                                             Grid.Row="0" Grid.Column="1"
                                             Margin="0,3,5,3" />
                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Margin="0,3,5,3" VerticalAlignment="Center"
                                               Text="画质优先级" />
                                    <TextBox x:Name="DfnPriorityBox"
                                             Grid.Row="1" Grid.Column="1"
                                             Margin="0,3,5,3" />
                                    <TextBlock Grid.Row="2" Grid.Column="0"
                                               Margin="0,3,5,3" VerticalAlignment="Center"
                                               Text="Cookie" />
                                    <TextBox x:Name="CookieBox"
                                             Grid.Row="2" Grid.Column="1"
                                             Margin="0,3,5,3" />
                                    <TextBlock Grid.Row="3" Grid.Column="0"
                                               Margin="0,3,5,3" VerticalAlignment="Center"
                                               Text="access_token" />
                                    <TextBox x:Name="AccessTokenBox"
                                             Grid.Row="3" Grid.Column="1"
                                             Margin="0,3,5,3" />
                                    <TextBlock Grid.Row="4" Grid.Column="0"
                                               Margin="0,3,5,3" VerticalAlignment="Center"
                                               Text="User-Agent" />
                                    <TextBox x:Name="UserAgentBox"
                                             Grid.Row="4" Grid.Column="1"
                                             Margin="0,3,5,3" />
                                    <TextBlock Grid.Row="5" Grid.Column="0"
                                               Margin="0,3,5,3" VerticalAlignment="Center"
                                               Text="工作目录" />
                                    <TextBox x:Name="WorkDirBox"
                                             Grid.Row="5" Grid.Column="1"
                                             Margin="0,3,5,3" />
                                    <TextBlock Grid.Row="6" Grid.Column="0"
                                               Margin="0,3,5,3" VerticalAlignment="Center"
                                               Text="FFmpeg 路径" />
                                    <TextBox x:Name="FFmpegPathBox"
                                             Grid.Row="6" Grid.Column="1"
                                             Margin="0,3,5,3" />
                                    <TextBlock Grid.Row="7" Grid.Column="0"
                                               Margin="0,3,5,3" VerticalAlignment="Center"
                                               Text="MP4Box 路径" />
                                    <TextBox x:Name="Mp4boxPathBox"
                                             Grid.Row="7" Grid.Column="1"
                                             Margin="0,3,5,3" />
                                    <TextBlock Grid.Row="8" Grid.Column="0"
                                               Margin="0,3,5,3" VerticalAlignment="Center"
                                               Text="aria2c 路径" />
                                    <TextBox x:Name="Aria2cPathBox"
                                             Grid.Row="8" Grid.Column="1"
                                             Margin="0,3,5,3" />
                                    <TextBlock Grid.Row="9" Grid.Column="0"
                                               Margin="0,3,5,3" VerticalAlignment="Center"
                                               Text="文件命名模式" />
                                    <TextBox x:Name="FilePatternBox"
                                             Grid.Row="9" Grid.Column="1"
                                             Margin="0,3,5,3" />
                                    <TextBlock Grid.Row="10" Grid.Column="0"
                                               Margin="0,3,5,3" VerticalAlignment="Center"
                                               Text="多 P 文件命名" />
                                    <TextBox x:Name="MultiFilePatternBox"
                                             Grid.Row="10" Grid.Column="1"
                                             Margin="0,3,5,3" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Expander>

                    <!--高级选项-->
                    <Expander Header="高级选项" Margin="0,5,0,0">
                        <Grid Margin="3,10,3,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                <CheckBox x:Name="AllowPcdnCheckBox" Margin="0,3" Content="允许 PCDN" />
                                <CheckBox x:Name="NoForceHostCheckBox" Margin="0,3" Content="不强制替换 host" />
                                <CheckBox x:Name="NoForceHttpCheckBox" Margin="0,3" Content="避免降级 HTTP" />
                            </StackPanel>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Margin="0,3,5,3" VerticalAlignment="Center"
                                           Text="DRM 密钥" />
                                <TextBox x:Name="DrmKeyBox"
                                         Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                                         Margin="0,3,0,3"
                                         AcceptsReturn="True" MaxLines="2" />
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Margin="0,3,5,3" VerticalAlignment="Center"
                                           Text="Host" />
                                <TextBox x:Name="HostBox"
                                         Grid.Row="1" Grid.Column="1"
                                         Margin="0,3,10,3" />
                                <TextBlock Grid.Row="1" Grid.Column="2"
                                           Margin="0,3,5,3" VerticalAlignment="Center"
                                           Text="EP Host" />
                                <TextBox x:Name="EpHostBox"
                                         Grid.Row="1" Grid.Column="3"
                                         Margin="0,3,0,3" />
                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Margin="0,3,5,3" VerticalAlignment="Center"
                                           Text="TV Host" />
                                <TextBox x:Name="TvHostBox"
                                         Grid.Row="2" Grid.Column="1"
                                         Margin="0,3,10,3" />
                                <TextBlock Grid.Row="2" Grid.Column="2"
                                           Margin="0,3,5,3" VerticalAlignment="Center"
                                           Text="Area" />
                                <TextBox x:Name="AreaBox"
                                         Grid.Row="2" Grid.Column="3"
                                         Margin="0,3,0,3" />
                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Margin="0,3,5,3" VerticalAlignment="Center"
                                           Text="Upos Host" />
                                <TextBox x:Name="UposHostBox"
                                         Grid.Row="3" Grid.Column="1"
                                         Margin="0,3,0,3" />
                            </Grid>
                        </Grid>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <!--底部：操作按钮-->
            <StackPanel Grid.Row="3" Margin="0,10,0,0" Orientation="Horizontal">
                <Button x:Name="RunButton"
                        Padding="15,3"
                        Click="RunButtonClicked" Content="执行" />
                <Button x:Name="EnqueueButton"
                        Margin="10,0,0,0" Padding="15,3"
                        Click="EnqueueButtonClicked" Content="加入任务队列" />
                <Button x:Name="ResetButton"
                        Margin="10,0,0,0" Padding="15,3"
                        Click="ResetButtonClicked" Content="重置选项" />
            </StackPanel>

        </Grid>

        <!--右侧边栏：任务队列-->
        <Grid Grid.Column="1"
              MinWidth="256" MaxWidth="512"
              Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListBox x:Name="TaskList">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="WrapWithOverflow" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="1"
                        Margin="0,10,0,0" HorizontalAlignment="Left"
                        Orientation="Horizontal">
                <TextBlock Margin="0,0,5,0" VerticalAlignment="Center" Text="并发数" />
                <TextBox x:Name="ConcurrencyBox"
                         LostKeyboardFocus="ConcurrencyBoxLostKeyboardFocus" Text="3"
                         TextAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0,10,0,0" Orientation="Horizontal">
                <Button x:Name="StartQueueButton"
                        Padding="15,3" HorizontalAlignment="Right"
                        Click="StartQueueButtonClicked" Content="开始队列" />
                <Button x:Name="RemoveButton"
                        Margin="10,0,0,0" Padding="15,3"
                        Click="RemoveButtonClicked" Content="移除" />
                <Button x:Name="ClearButton"
                        Margin="10,0,0,0" Padding="15,3"
                        Click="ClearButtonClicked" Content="清空已完成" />
            </StackPanel>

            <!--底部：日志区-->
            <Expander Header="日志" Grid.Row="3" Margin="0,5,0,0">
                <TextBox x:Name="LogBox"
                         MaxHeight="256"
                         FontFamily="Consolas"
                         AcceptsReturn="True" HorizontalScrollBarVisibility="Auto" IsReadOnly="True"
                         TextWrapping="WrapWithOverflow" VerticalScrollBarVisibility="Auto" />
            </Expander>
        </Grid>
    </Grid>
</Window>
