<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 表单标签：字段名 TextBlock 的统一边距；BasedOn 继承 Aero 主题默认样式 -->
    <Style x:Key="FieldLabel"
           TargetType="TextBlock"
           BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Margin" Value="0,3,5,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 表单输入框：字段 TextBox 的统一边距 -->
    <Style x:Key="FieldInput"
           TargetType="TextBox"
           BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Margin" Value="0,3,5,3" />
    </Style>

    <!-- 复选框行：选项列的统一边距 -->
    <Style x:Key="CheckBoxItem"
           TargetType="CheckBox"
           BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Margin" Value="0,3" />
    </Style>

    <!-- 操作按钮：统一内边距，Margin 按布局就地覆盖 -->
    <Style x:Key="ButtonAction"
           TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="15,3" />
    </Style>

</ResourceDictionary>
