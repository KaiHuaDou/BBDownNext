<Window x:Class="BBDown.GUI.AskDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:workflow="using:BBDown.Core.Workflow"
        Title="请选择"
        Width="420"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptText"
                   Margin="0,0,0,12"
                   FontSize="14"
                   TextWrapping="Wrap" />
        <ListBox x:Name="OptionList" MaxHeight="300" HorizontalAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="workflow:AskOption">
                    <Button Padding="12,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="OptionClicked"
                            Content="{Binding Label}"
                            Tag="{Binding}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button x:Name="DismissButton"
                Margin="0,14,0,0" Padding="30,5" HorizontalAlignment="Center"
                Click="DismissButtonClicked" Content="取消" />
    </StackPanel>
</Window>
